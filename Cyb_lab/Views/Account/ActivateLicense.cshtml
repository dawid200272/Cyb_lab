@using Cyb_lab.ViewModels
@model ActivateLicenseViewModel

@{
	ViewData["Title"] = "ActivateLicense";
}

<div class="text-center">
	<h1 class="display-4">@ViewData["Title"]</h1>

	@if (Model.IsLicenseActivated)
	{
		<p>License is activated for this account</p>
	}
	else
	{
		<p>Activate license</p>
		<form method="post">
			<div asp-validation-summary="All" class="text-danger"></div>
			<div class="form-group">
				<label asp-for="ActivationKey"></label>
				<input asp-for="ActivationKey" class="form-control" />
				<span asp-validation-for="ActivationKey" class="text-danger"></span>
			</div>
			<button type="submit" class="btn btn-primary">Activate</button>
		</form>
	}
</div>
