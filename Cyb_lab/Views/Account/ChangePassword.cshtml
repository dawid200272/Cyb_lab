@using Cyb_lab.ViewModels
@model ChangePasswordViewModel
@inject IConfiguration _configuration

@{
	ViewData["Title"] = "Change password";
	var siteKey = _configuration["GoogleRecaptchav3:SiteKey"];
}

<h1>@ViewData["Title"]</h1>
<div class="row">
	<div class="col-md-6">
		<form id="change-password-form" method="post">
			<input type="hidden" id="ChangePasswordViewModelToken" asp-for="Token" />
			<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
			<div class="form-floating mb-3">
				<input asp-for="OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
				<label asp-for="OldPassword" class="form-label"></label>
				<span asp-validation-for="OldPassword" class="text-danger"></span>
			</div>
			<div class="form-floating mb-3">
				<input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
				<label asp-for="NewPassword" class="form-label"></label>
				<span asp-validation-for="NewPassword" class="text-danger"></span>
			</div>
			<div class="form-floating mb-3">
				<input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
				<label asp-for="ConfirmPassword" class="form-label"></label>
				<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
			</div>
			<button type="submit" class="w-100 btn btn-lg btn-primary">Update password</button>
		</form>
	</div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://www.google.com/recaptcha/api.js?render=@siteKey"></script>
<script>
	function getToken() {
		grecaptcha.ready(function () {
			grecaptcha.execute('@siteKey', { action: 'submit' }).then(function (token) {
				console.log(token);
				document.getElementById("ChangePasswordViewModelToken").value = token;
			});
		});
	}

	setInterval(getToken, 115000);

	$(function () {
		getToken();
	});
</script>