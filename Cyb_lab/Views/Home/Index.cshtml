@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Main page</h1>

    <a asp-controller="Account" asp-action="ActivateLicense">License</a>

    <a asp-controller="Home" asp-action="ShowFiles">Show files</a>

    @* Only user with admin role sees this *@
    @if (User.IsInRole("Administrator"))
    {
        <h2>Admin</h2>
        <a asp-controller="Admin" asp-action="Panel">Admin Panel</a>
        @* open admin panel here  *@
    }
</div>
