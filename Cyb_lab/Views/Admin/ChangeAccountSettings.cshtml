@using Cyb_lab.Options
@model LockoutSettingsOptions

@{
	ViewData["Title"] = "ChangeAccountSettings";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="ChangeAccountSettings">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="form-group">
				<label asp-for="DefaultLockoutTimeSpan" class="control-label"></label>
				<input asp-for="DefaultLockoutTimeSpan" class="form-control" />
				<span asp-validation-for="DefaultLockoutTimeSpan" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="MaxFailedAccessAttempts" class="control-label"></label>
				<input asp-for="MaxFailedAccessAttempts" class="form-control" />
				<span asp-validation-for="MaxFailedAccessAttempts" class="text-danger"></span>
			</div>
			<div class="form-group form-check">
				<label class="form-check-label">
					<input class="form-check-input" asp-for="AllowedForNewUsers" /> @Html.DisplayNameFor(model => model.AllowedForNewUsers)
				</label>
			</div>
			<div class="form-group">
				<label asp-for="InactivityTime" class="control-label"></label>
				<input asp-for="InactivityTime" class="form-control" />
				<span asp-validation-for="InactivityTime" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input type="submit" value="Save" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Panel">Back to panel</a>
</div>

